# Flixie App Configuration

# Backend API URL
# For local development with simulator:
FLIXIE_API_URL=http://localhost:3000/api

# For local development with real device (replace with your Mac's IP):
# FLIXIE_API_URL=http://192.168.1.100:3000/api

# For production:
# FLIXIE_API_URL=https://api.flixie.com/api

# Note: To use these environment variables in Xcode:
# 1. Click the scheme selector in Xcode (next to Run/Stop buttons)
# 2. Select "Edit Scheme..."
# 3. Go to Run → Arguments → Environment Variables
# 4. Click "+" and add: FLIXIE_API_URL with your desired value
